# Copy to .env.local and fill in. Never commit .env.local.

# OpenAI key with image-generation access (gpt-image models may require org verification).
OPENAI_API_KEY=sk-your-key-here

# Scryfall requires a User-Agent that identifies your app. Include a contact.
SCRYFALL_USER_AGENT=MTGArt/1.0 (you@example.com)

# Drivers. Local dev defaults are fine.
STORAGE_DRIVER=local
JOB_DRIVER=memory

# Optional models (defaults chosen in code if unset).
# IMAGE_MODEL: gpt-image-2 (default), gpt-image-1.5, or gpt-image-1-mini.
# TEXT_MODEL: art-director / style-enrich model. Defaults to gpt-5-mini and
# automatically falls back to gpt-4o-mini if that is not on your account.
IMAGE_MODEL=gpt-image-2
TEXT_MODEL=gpt-5-mini

# Optional hard spend backstop in USD across a single batch.
MAX_BATCH_SPEND_USD=25

# Max simultaneous image requests. Keep BELOW your OpenAI account's concurrency
# limit (if the limit is 20, 16-18 is safe). Full-send never exceeds this.
MAX_CONCURRENCY=16
